Bundle-Version: ${project-version}
Bundle-Name: Gecko Weather DWD Stations
Bundle-Description: Gecko Weather - Station fetch and search DWD weather stations

-library: \
	enableSearch,\
	enable-emf

-buildpath: \
	org.osgi.service.component;version=latest,\
	org.osgi.util.promise;version=latest,\
	org.apache.felix.gogo.runtime;version=latest,\
	org.apache.lucene.core;version=latest,\
	org.apache.lucene.spatial;version=latest,\
	org.gecko.search;version=latest,\
	org.gecko.search.document;version=latest,\
	org.gecko.search.util;version=latest,\
	org.gecko.emf.search;version=latest,\
	org.gecko.weather.model;version=snapshot,\
	org.gecko.weather.api;version=snapshot,\
	org.eclipse.osgi-technology.scheduler.api;version=latest