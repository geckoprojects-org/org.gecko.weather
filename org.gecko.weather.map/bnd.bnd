Bundle-Name: Gecko Weather Map
Bundle-Description: Maps from whole gridded fields: the total cloud cover of the newest ICON-D2 run \
	as disjoint bands of polygons (GeoJSON model), one feature per band and hour, kept on disk as \
	GeoJSON and served as the OGC API Features collection cloudcover of Fennec OGC Features.

src: src-gen,src

-library: enableEMF

-generate: \
	model/cloudmap.ecore; \
		generate=fennecEMF; \
		ecore=model/cloudmap.ecore; \
		output=src-gen

-includeresource.model: model=model

-buildpath: \
	org.gecko.weather.model;version=snapshot,\
	org.gecko.weather.api;version=snapshot,\
	org.geojson.model;version=latest,\
	org.eclipse.fennec.ogc.features.api;version=latest,\
	org.eclipse.fennec.ogc.features.geo;version=latest,\
	org.eclipse.fennec.ogc.features.source.memory;version=latest,\
	tools.jackson.core.jackson-core;version=latest,\
	tools.jackson.core.jackson-databind;version=latest,\
	org.osgi.service.component.annotations;version=latest,\
	org.osgi.service.metatype.annotations;version=latest

# the recorded clct field of the ICON-D2 provider, read the way the provider reads it; the GeoJSON
# codec for the round trip through a file
-testpath: \
	org.gecko.weather.transport;version=snapshot,\
	org.gecko.weather.grib2;version=snapshot,\
	org.gecko.ucar.netcdf;version=snapshot,\
	com.google.guava;version=latest,\
	com.google.guava.failureaccess;version=latest,\
	com.google.protobuf;version=latest,\
	joda-time;version=latest,\
	slf4j.api;version=latest,\
	org.apache.commons.commons-compress;version=latest,\
	org.apache.commons.commons-io;version=latest,\
	org.eclipse.fennec.codec.geojson;version=latest,\
	org.eclipse.fennec.codec;version=latest,\
	org.eclipse.fennec.codec.api;version=latest,\
	org.eclipse.fennec.codec.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.metadata;version=latest,\
	org.eclipse.fennec.emf.osgi.component.minimal;version=latest,\
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	org.locationtech.jts.jts-core;version=latest,\
	org.eclipse.fennec.ogc.features.cql2;version=latest,\
	net.opengis.cql2.model;version=latest,\
	assertj-core;version=latest
