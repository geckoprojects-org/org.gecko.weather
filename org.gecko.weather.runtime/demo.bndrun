# Demo launch: the developer launch (MCP server on 8088) plus the weather outlook and the PV forecast
# as remote services — Remote Service Admin of Fennec Services derives the WeatherOutlook contract, serves it
# over REST on :9093/weather and announces it to the DDSR broker. The UI under ui/outlook finds it
# there. Needs a running broker (emf.services, port 8887); see ui/outlook/README.md.
#
#   ./gradlew :org.gecko.weather.runtime:resolve.demo
#   ./gradlew :org.gecko.weather.runtime:export.demo
#   WEATHER_PUBLIC_URL=http://localhost:5181/weather java -jar org.gecko.weather.runtime/generated/distributions/executable/demo.jar

# tilde: what this file defines wins over the included launch
-include: ~dev.bndrun

-library: enableJakartaREST

# As in emf.services' payment-provider.bndrun: the library's own list brings a second, older HTTP
# stack; the resolve picks the one needed.
jersey.deps:

-runproperties: \
	org.osgi.framework.bootdelegation=sun.*,com.sun.*,\
	gosh.args="--nointeractive --noshutdown",\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation

-runrequires: \
	bnd.identity;id='org.gecko.weather.runtime',\
	bnd.identity;id='org.gecko.weather.shell',\
	bnd.identity;id='org.gecko.weather.core',\
	bnd.identity;id='org.gecko.weather.repository.file',\
	bnd.identity;id='org.gecko.weather.solar',\
	bnd.identity;id='org.gecko.weather.ingest',\
	bnd.identity;id='org.gecko.weather.provider.dwd.mosmix',\
	bnd.identity;id='org.gecko.weather.provider.dwd.icon',\
	bnd.identity;id='org.gecko.weather.provider.dwd.sis',\
	bnd.identity;id='org.gecko.weather.provider.dwd.uv',\
	bnd.identity;id='org.apache.commons.commons-io',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='net.opengis.kml.model',\
	bnd.identity;id='de.dwd.cdc.forecast.model',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	osgi.implementation;filter:='(osgi.implementation=mcp.gogo)',\
	bnd.identity;id='org.gecko.weather.runtime.dev',\
	bnd.identity;id='slf4j.simple',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.bundle',\
	bnd.identity;id='org.gecko.weather.outlook',\
	bnd.identity;id='org.gecko.weather.pv',\
	bnd.identity;id='org.gecko.weather.runtime.remote',\
	bnd.identity;id='org.eclipse.fennec.services.rsa',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.config',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.distribution.rest',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.discovery.rest',\
	bnd.identity;id='org.eclipse.fennec.services.rsa.topology',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.eobject.registry',\
	bnd.identity;id='org.eclipse.fennec.services.client.java',\
	bnd.identity;id='org.eclipse.fennec.services.client.rest',\
	bnd.identity;id='org.eclipse.fennec.services.provider.rest',\
	bnd.identity;id='org.apache.felix.http.jetty12',\
	bnd.identity;id='org.eclipse.parsson.jakarta.json',\
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation'

-runblacklist: \
	bnd.identity;id='org.osgi.service.cm',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension',\
	bnd.identity;id='org.apache.felix.http.jetty'
-runbundles: \
	com.ethlo.time.itu;version='[1.14.0,1.14.1)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[2.22.0,2.22.1)',\
