# Local launch: Felix, Gogo shell, Configurator with this bundle's defaults (configs/weather.json),
# Fennec EMF runtime, the weather bundles and the DWD providers (MOSMIX_L, ICON-D2, SIS).
#
#   ./gradlew :org.gecko.weather.runtime:resolve      # refresh -runbundles after a dependency change
#   ./gradlew :org.gecko.weather.runtime:export       # executable jar under generated/distributions
#
# In the shell: weather:register home "Home roof" 51.05 13.74 118
#               weather:runNow dwd MOSMIX_L
#               weather:report home
#               weather:values home AIR_TEMPERATURE

-runfw: org.apache.felix.framework
-runee: JavaSE-21
-runsystemcapabilities: ${native_capability}
-resolve.effective: active;skip:="osgi.service"

-runproperties: \
	org.osgi.framework.bootdelegation=sun.*,com.sun.*

-runrequires: \
	bnd.identity;id='org.gecko.weather.runtime',\
	bnd.identity;id='org.gecko.weather.shell',\
	bnd.identity;id='org.gecko.weather.core',\
	bnd.identity;id='org.gecko.weather.repository.file',\
	bnd.identity;id='org.gecko.weather.solar',\
	bnd.identity;id='org.gecko.weather.ingest',\
	bnd.identity;id='org.gecko.weather.provider.dwd.mosmix',\
	bnd.identity;id='org.gecko.weather.provider.dwd.icon',\
	bnd.identity;id='org.gecko.weather.provider.dwd.sis',\
	bnd.identity;id='org.apache.commons.commons-io',\
	bnd.identity;id='org.eclipse.fennec.emf.osgi.component.minimal',\
	bnd.identity;id='net.opengis.kml.model',\
	bnd.identity;id='de.dwd.cdc.forecast.model',\
	bnd.identity;id='org.apache.felix.configurator',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell'

-runblacklist: \
	bnd.identity;id='org.osgi.service.cm',\
	bnd.identity;id='org.apache.aries.spifly.dynamic.framework.extension'

-runbundles: \
	de.dwd.cdc.forecast.model;version='[1.0.0,1.0.1)',\
	net.opengis.kml.model;version='[2.2.0,2.2.1)',\
	org.apache.felix.cm.json;version='[2.0.6,2.0.7)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.configurator;version='[1.0.18,1.0.19)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.apache.felix.scr;version='[2.2.12,2.2.13)',\
	org.eclipse.emf.common;version='[2.44.0,2.44.1)',\
	org.eclipse.emf.ecore;version='[2.41.0,2.41.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.39.0,2.39.1)',\
	org.eclipse.fennec.emf.osgi.component.minimal;version='[1.1.0,1.1.1)',\
	org.eclipse.parsson.jakarta.json;version='[1.1.7,1.1.8)',\
	org.gecko.weather.api;version=snapshot,\
	org.gecko.weather.core;version=snapshot,\
	org.gecko.weather.ingest;version=snapshot,\
	org.gecko.weather.model;version=snapshot,\
	org.gecko.weather.provider.dwd.mosmix;version=snapshot,\
	org.gecko.weather.repository.file;version=snapshot,\
	org.gecko.weather.runtime;version=snapshot,\
	org.gecko.weather.shell;version=snapshot,\
	org.gecko.weather.solar;version=snapshot,\
	org.gecko.weather.transport;version=snapshot,\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	org.w3.atom.model;version='[1.0.0,1.0.1)',\
	solarpositioning-osgi;version='[3.0.1,3.0.2)',\
	com.google.guava;version='[32.1.3,32.1.4)',\
	com.google.guava.failureaccess;version='[1.0.1,1.0.2)',\
	com.google.protobuf;version='[3.25.5,3.25.6)',\
	joda-time;version='[2.12.7,2.12.8)',\
	org.apache.aries.spifly.dynamic.bundle;version='[1.3.7,1.3.8)',\
	org.apache.commons.commons-compress;version='[1.28.0,1.28.1)',\
	org.apache.commons.commons-io;version='[2.22.0,2.22.1)',\
	org.gecko.ucar.netcdf;version=snapshot,\
	org.gecko.ucar.units;version='[5.6.0,5.6.1)',\
	org.gecko.weather.provider.dwd.icon;version=snapshot,\
	org.objectweb.asm;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.commons;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.tree;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.tree.analysis;version='[9.10.1,9.10.2)',\
	org.objectweb.asm.util;version='[9.10.1,9.10.2)',\
	slf4j.api;version='[2.0.17,2.0.18)',\
	slf4j.simple;version='[2.0.17,2.0.18)',\
	org.gecko.weather.provider.dwd.sis;version=snapshot
