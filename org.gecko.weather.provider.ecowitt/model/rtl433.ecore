<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="rtl433" nsURI="https://geckoprojects.org/rtl433/1.0" nsPrefix="rtl433">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="copyrightText" value="Copyright (c) 2012 - 2026 Data In Motion and others.&#xA;All rights reserved.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0&#xA;&#xA;Contributors:&#xA;     Data In Motion - initial API and implementation"/>
    <details key="documentation" value="One decoded telegram as rtl_433 emits it in its JSON output (-F json, -F http /stream, MQTT): the generic envelope (time, model, id, signal) and the fields the Fine Offset / Ecowitt station decoders produce (WS90, WS80). Member names are rtl_433&apos;s, mapped through the codec key annotation; units are rtl_433&apos;s canonical SI ones (°C, m/s, mm, lux). Fields a telegram does not carry are null; fields the model does not know are skipped."/>
    <details key="complianceLevel" value="21.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.gecko.weather.provider.ecowitt.model"/>
    <details key="prefix" value="Rtl433"/>
    <details key="modelName" value="Rtl433"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Reading">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="One line of the rtl_433 JSON stream."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="time" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Receive time as rtl_433 formats it (local time without zone unless -M time:utc); the receiver stamps its own clock instead."/>
      </eAnnotations>
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="key" value="time"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="model" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The decoder&apos;s device model name, e.g. Fineoffset-WS90."/>
      </eAnnotations>
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="key" value="model"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The device&apos;s own id, fixed per sensor (changes on a battery swap for some models)."/>
      </eAnnotations>
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="key" value="id"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="channel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="key" value="channel"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="batteryOk" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="1.0 is fine, lower values mean a weak battery."/>
      </eAnnotations>
      <eAnnotations source="http://eclipse.org/fennec/codec">
        <details key="key" value="battery_ok"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="batteryMilliVolts" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject">
