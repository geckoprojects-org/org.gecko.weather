{
	":configurator:resource-version": 1,

	"org.eclipse.fennec.services.rsa.provider": {
		"broker.url": "$[env:DDSR_BROKER_URL;default=http://localhost:8887/ddsr/rest]",
		"http.port": "$[env:WEATHER_HTTP_PORT;default=9093]",
		"http.id": "weatherRemoteHttp",
		"context.path": "weather",
		"public.host": "$[env:WEATHER_PUBLIC_HOST;default=localhost]",
		"public.url": "$[env:WEATHER_PUBLIC_URL;default=]",
		"registry.name": "gecko-weather",
		"provider.heartbeat.seconds": "30",
		"session.interval.seconds": "0"
	},

	"org.gecko.weather.outlook.internal.WeatherOutlookComponent": {
		"hours": "$[env:WEATHER_OUTLOOK_HOURS;type=Integer;default=24]",
		"days": "$[env:WEATHER_OUTLOOK_DAYS;type=Integer;default=2]",
		"defaultTimeZone": "Europe/Berlin"
	},

	"org.gecko.weather.pv.internal.PvForecastComponent": {
		"plantsFolder": "$[env:WEATHER_PV_PLANTS;default=data/weather/plants]",
		"hours": "$[env:WEATHER_PV_HOURS;type=Integer;default=48]",
		"days": "$[env:WEATHER_PV_DAYS;type=Integer;default=7]",
		"defaultTimeZone": "Europe/Berlin",
		"measurementsFolder": "$[env:WEATHER_PV_MEASUREMENTS;default=data/weather/pv-measurements]",
		"metering": "$[env:WEATHER_PV_METERING;type=Boolean;default=true]",
		"snapshotsFolder": "$[env:WEATHER_PV_SNAPSHOTS;default=data/weather/pv-forecasts]",
		"snapshotHours": "$[env:WEATHER_PV_SNAPSHOT_HOURS;default=6,18]"
	}
}
