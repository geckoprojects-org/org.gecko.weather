Bundle-Name: Gecko Weather Transport
Bundle-Description: Shared byte transport for providers: HTTP with conditional requests over the \
	JDK HttpClient, archive unwrapping (zip, gzip, bzip2). Knows nothing about what the bytes mean.

-library: enableEMF

-buildpath: \
	org.gecko.weather.api;version=snapshot,\
	org.apache.commons.commons-compress;version=latest

-testpath: \
	org.apache.commons.commons-io;version=latest,\
	assertj-core;version=latest
