Bundle-Name: Gecko Weather Solar (Time4J)
Bundle-Description: SolarService over Time4J: sun elevation and azimuth at an instant, day events \
	(sunrise, sunset, twilight, solar noon, day length) for a date in the site's time zone.

-library: enableEMF

-buildpath: \
	org.gecko.weather.model;version=snapshot,\
	org.gecko.weather.api;version=snapshot,\
	time4j-base;version=latest

-testpath: \
	assertj-core;version=latest
