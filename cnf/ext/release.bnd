# Where a release goes.
#
# The fennec library (cnf/ext/fennec.bnd, -library: fennec) brings the mechanics: DO_RELEASE
# decides the version bnd stamps on every bundle (releng/snapshot.bnd: ${tstamp}-SNAPSHOT;
# releng/release.bnd: the bare version), '-pom: true' and '-maven-release: pom' the Maven side,
# and — only when GPG_PASSPHRASE is set and maven-central is true — releng/central.bnd: the
# 'Sonatype' repository of bnd 7.4's Sonatype Central Portal support (stagingUrl =
# production.portal.central.sonatype.com, sonatypeMode = autopublish, signed with
# '-maven-release: pom, sign'), which then becomes '-releaserepo'.
#
# This workspace adds the DIM Nexus beside it. '-releaserepo' is set here outright (what the
# workspace sets wins over the library), so the Nexus is on every release and Sonatype only
# when the library has configured it:
#   snapshot branch (no GPG):  -releaserepo = Release            → dim-snapshot
#   main branch (GPG + Portal): -releaserepo = Sonatype, Release → Maven Central and dim-release
# Which Nexus URL is used follows from the version: a -SNAPSHOT goes to snapshotUrl. (Not a
# '-releaserepo.nexus' suffix key: merged with the library's 'Release' that gives 'Release~',
# a name no repository has.)
#
# Credentials are not in the repository. '-connection-settings' is merged over suffix keys, so
# the Nexus server is added to whatever the library configures for the Portal: on Jenkins the
# credential 'dim-nexus' arrives as NEXUS_USERNAME/NEXUS_PASSWORD (the inline server below); a
# developer keeps a <server> with <id>devel.data-in-motion.biz</id> in ~/.m2/settings.xml, which
# '-maven' reads. The Portal ones come from the library's sonatype-settings.xml, which reads
# CS_USERNAME and CS_PASSWORD; the GPG key from GPG_KEY_ID and GPG_PASSPHRASE.
# See docs/12-build-and-release.md and the Jenkinsfile.

-plugin.7.Release: \
	aQute.bnd.repository.maven.provider.MavenBndRepository;\
		releaseUrl  = https://devel.data-in-motion.biz/nexus/repository/dim-release/;\
		snapshotUrl = https://devel.data-in-motion.biz/nexus/repository/dim-snapshot/;\
		name        = 'Release'

-releaserepo: ${if;${env;GPG_PASSPHRASE;};${if;${maven-central};Sonatype,Release;Release};Release}

-connection-settings.nexus: \
	-maven,\
	server; \
		id=devel.data-in-motion.biz; \
		username="${env;NEXUS_USERNAME;}"; \
		password="${env;NEXUS_PASSWORD;}"
