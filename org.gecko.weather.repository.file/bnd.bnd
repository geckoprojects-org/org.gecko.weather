Bundle-Name: Gecko Weather File Repository
Bundle-Description: WeatherRepository as a folder of XMI files: sites, current reports, an \
	append-only archive of superseded datasets and provider catalogues. Root folder configurable.

-library: enableEMF

-buildpath: \
	org.gecko.weather.model;version=snapshot,\
	org.gecko.weather.api;version=snapshot,\
	org.osgi.service.metatype.annotations;version=latest

-testpath: \
	assertj-core;version=latest
