    "@ddsr/telemetry": "file:vendor/ddsr/ddsr-telemetry-82e7f3b.tgz",
    "@emfts/core": "0.3.0-next.1",
    "three": "^0.180.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.2.3",
